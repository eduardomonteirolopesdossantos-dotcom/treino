{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vestibular-bia",
  "compatibility_date": "2026-05-23",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "VESTIBULAR_KV",
      "id": "a7d11a26c6884aa39ad3d1dc5dfa9a3f"
    }
  ]
}
